---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { copy } from '../i18n/id';

const locale = 'id' as const;
const canonicalUrl = new URL('/id/', Astro.site).href;
---

<BaseLayout {...copy} {locale} {canonicalUrl}>
  <HomeContent copy={copy} />
</BaseLayout>
