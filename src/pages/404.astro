---
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c1320" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Halaman tidak ditemukan — Indy Adira Khalfani</title>
  </head>
  <body>
    <div class="site-shell">
      <main class="page-content">
        <section class="hero" aria-labelledby="error-title">
          <div class="hero-meta">
            <span class="eyebrow">~/error · 404</span>
          </div>
          <h1 id="error-title">404.</h1>
          <p class="hero-bio">
            Halaman yang kamu cari tidak ada. Kembali ke
            <a href="/id/">beranda Indonesia</a> atau
            <a href="/en/">English home</a>.
          </p>
          <p class="hero-bio">
            The page you are looking for does not exist. Go back to the
            <a href="/id/">Indonesian home</a> or
            <a href="/en/">English home</a>.
          </p>
        </section>
      </main>
      <footer class="site-footer">
        <span>© 2026 Indy Adira Khalfani</span>
      </footer>
    </div>
  </body>
</html>
