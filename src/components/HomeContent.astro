---
import { properties, site } from '../types/site';

type PillarCopy = {
  description: string;
  action: string;
};

type Copy = {
  hero: {
    eyebrow: string;
    role: string;
    rotating: readonly string[];
    bio: string;
    availability: string;
    cta: string;
  };
  capabilities: {
    title: string;
    items: {
      name: string;
      context: string;
      tools: string;
    }[];
  };
  pillars: {
    title: string;
    portfolio: PillarCopy;
    blog: PillarCopy;
    wiki: PillarCopy;
    tools: PillarCopy;
  };
  links: {
    title: string;
    github: string;
    linkedin: string;
    email: string;
    githubHandle: string;
    linkedinHandle: string;
    emailHandle: string;
  };
};

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const pillarKeys = ['portfolio', 'blog', 'wiki', 'tools'] as const;
---

<main class="page-content">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-meta">
      <span class="eyebrow">{copy.hero.eyebrow}</span>
      <span class="availability"><span class="availability-dot" aria-hidden="true"></span>{copy.hero.availability}</span>
    </div>
    <h1 id="hero-title">Indy Adira<br /><em>Khalfani.</em></h1>
    <p class="hero-rotating"><span class="dash" aria-hidden="true">—</span><span class="rotator" data-rotator data-words={JSON.stringify(copy.hero.rotating)}>{copy.hero.rotating[0]}</span><span class="sr-only">{copy.hero.role}</span></p>
    <p class="hero-bio">{copy.hero.bio}</p>
    <a class="primary-link" href="https://portofolio.indyadirak.my.id" rel="noopener noreferrer">
      <span>{copy.hero.cta}</span><span class="arrow" aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="content-section capabilities reveal" aria-labelledby="capabilities-title">
    <h2 id="capabilities-title">{copy.capabilities.title}</h2>
    <div class="capability-list">
      {copy.capabilities.items.map((item, index) => (
        <div class="capability-item">
          <span class="capability-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.name}</h3>
          <p class="capability-context">{item.context}</p>
          <p>{item.tools}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="content-section pillars reveal" aria-labelledby="pillars-title">
    <h2 id="pillars-title">{copy.pillars.title}</h2>
    {pillarKeys.map((key) => {
      const property = properties.find((item) => item.key === key)!;
      const item = copy.pillars[key];
      return <a class:list={['pillar', property.key === 'portfolio' && 'pillar-featured', property.status === 'coming-soon' && 'pillar-disabled']} href={property.status === 'live' ? property.href : undefined} rel={property.status === 'live' ? 'noopener noreferrer' : undefined} aria-disabled={property.status === 'coming-soon' ? 'true' : undefined}>
        <span class="pillar-heading"><strong>{property.key}</strong>{property.key !== 'portfolio' && <small>{`· ${property.language}`}</small>}</span>
        <span class="pillar-description">{item.description}</span>
        <span class="pillar-action">{item.action} {property.status === 'live' && <span aria-hidden="true">↗</span>}</span>
      </a>;
    })}
  </section>
  <section class="content-section selected-links reveal" aria-labelledby="links-title">
    <h2 id="links-title">{copy.links.title}</h2>
    <div class="link-row">
      <a href={site.github} target="_blank" rel="noopener noreferrer"><span class="link-text"><span class="link-label">{copy.links.github}</span><span class="link-handle">{copy.links.githubHandle}</span></span><span class="arrow" aria-hidden="true">↗</span></a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer"><span class="link-text"><span class="link-label">{copy.links.linkedin}</span><span class="link-handle">{copy.links.linkedinHandle}</span></span><span class="arrow" aria-hidden="true">↗</span></a>
      <a href={`mailto:${site.email}`}><span class="link-text"><span class="link-label">{copy.links.email}</span><span class="link-handle">{copy.links.emailHandle}</span></span><span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</main>
